<article class="kq-project-card">
    <div class="gh-card-link">
        {{#if feature_image}}
            <figure class="gh-card-image">
                <img
                    srcset="{{img_url feature_image size="xs" format="webp"}} 160w,
                            {{img_url feature_image size="s" format="webp"}} 320w,
                            {{img_url feature_image size="m" format="webp"}} 600w,
                            {{img_url feature_image size="l" format="webp"}} 960w,
                            {{img_url feature_image size="xl" format="webp"}} 1200w,
                            {{img_url feature_image size="xxl" format="webp"}} 2000w"
                    sizes="auto, (max-width: 767px) 100vw, (max-width: 1199px) 50vw, 400px"
                    src="{{img_url feature_image size="m"}}"
                    alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                    loading="lazy"
                >
            </figure>
        {{else}}
            <div class="gh-card-image kq-card-placeholder" aria-hidden="true"></div>
        {{/if}}
        <div class="gh-card-wrapper">
            <div class="kq-project-meta">
            {{#foreach tags visibility="internal"}}
                {{#match slug "~^" "hash-status-"}}
                    <span class="kq-status-badge">{{#split name separator="#status-"}}{{this.[0]}}{{/split}}</span>
                {{/match}}
            {{/foreach}}
            <div class="kq-project-stack">
                {{#foreach tags visibility="internal"}}
                    {{#match slug "~^" "hash-stack-"}}
                        <span class="kq-stack-chip">{{#split name separator="#stack-"}}{{this.[0]}}{{/split}}</span>
                    {{/match}}
                {{/foreach}}
            </div>
            </div>
            <div class="kq-project-head">
                <h3 class="gh-card-title is-title"><a class="kq-card-stretch" href="{{url}}">{{title}}</a></h3>
                {{#if feature_image_caption}}<span class="kq-project-links">{{feature_image_caption}}</span>{{/if}}
            </div>
            <p class="gh-card-excerpt is-body">{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="30"}}{{/if}}</p>
        </div>
    </div>
</article>
