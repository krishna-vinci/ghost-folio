<article class="kq-featured-card kq-featured-lead">
    <div class="kq-featured-media{{#has tag="#video"}} is-video kq-video-thumbnail{{/has}}">
        {{#if feature_image}}
            <img
                srcset="{{img_url feature_image size="m" format="webp"}} 600w,
                        {{img_url feature_image size="l" format="webp"}} 960w,
                        {{img_url feature_image size="xl" format="webp"}} 1200w"
                sizes="(max-width: 899px) 100vw, 680px"
                src="{{img_url feature_image size="l"}}"
                alt="" loading="lazy">
        {{/if}}
        {{#has tag="#video"}}
            <svg class="kq-play-icon" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M8 5v14l11-7z"/></svg>
        {{/has}}
    </div>
    <p class="kq-type-label"><svg class="kq-pin-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 17v5"/><path d="M9 3h6l-1 7 3 3v2H7v-2l3-3z"/></svg>Pinned · {{#has tag="#video"}}Video{{else}}Essay{{/has}}</p>
    <h3 class="gh-card-title kq-lead-title"><a class="kq-card-stretch" href="{{url}}">{{title}}</a></h3>
    <p class="kq-featured-excerpt">{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="30"}}{{/if}}</p>
</article>
