{{!-- Parameters: showTitle (true, false), title (optional heading). --}}
<section class="gh-container is-list gh-outer">
    <div class="gh-container-inner gh-inner">
        {{#if showTitle}}
            <h2 class="gh-container-title">{{#if title}}{{title}}{{else}}{{t "Latest"}}{{/if}}</h2>
        {{/if}}
        <div class="gh-main">
            <div class="gh-feed">
                {{#foreach posts}}
                    {{> "post-card" lazyLoad=true}}
                {{/foreach}}
            </div>
            {{#match pagination.pages ">" 1}}{{pagination}}{{/match}}
        </div>
    </div>
</section>
